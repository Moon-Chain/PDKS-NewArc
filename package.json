{
  "name": "pdks",
  "version": "1.0.0",
  "type": "module",
  "description": "PDKS - Personel Devam Kontrol Sistemi",
  "scripts": {
    "dev": "concurrently \"tsx watch server.ts\" \"tsx build.ts --watch\"",
    "build": "tsc --noEmit && tsx build.ts",
    "build:watch": "tsx build.ts --watch",
    "start": "node dist/server.js",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "test": "jest --config jest.config.cjs --no-coverage",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/multer": "^2.1.0",
    "alpinejs": "^3.15.12",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
