{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "build.ts",
    "db/**/*.ts",
    "core/**/*.ts",
    "shared/**/*.ts",
    "repositories/**/*.ts",
    "services/**/*.ts",
    "middleware/**/*.ts",
    "routes/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public/ts",
    "dist"
  ]
}
