PORT=3005
NODE_ENV=development
APP_URL=http://localhost:3005

# Cloudflare / ngrok gibi dış erişim URL'leri (virgülle ayır)
# Örnek: ALLOWED_ORIGINS=https://pdks.ornekfirma.com,https://xxxx.trycloudflare.com
ALLOWED_ORIGINS=

# JWT — en az 64 karakter rastgele string
JWT_SECRET=development_secret_buraya_gercek_bir_string_koy_en_az_64_karakter_olmali

# PostgreSQL
DATABASE_URL=postgresql://postgres:@localhost:5432/pdks

# Push Bildirimleri — 0e kademesinde eklenecek
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@sirket.com

# Sentry — opsiyonel
SENTRY_DSN=
